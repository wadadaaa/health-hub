# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 24

# Public hostname pointing at the VPS (A record). Caddy gets a Let's Encrypt cert automatically.
DOMAIN=health.example.com

POSTGRES_PASSWORD=

# Secret path segment for the claude.ai custom connector:
#   https://$DOMAIN/mcp/$MCP_PATH_SECRET
MCP_PATH_SECRET=

# Bearer token for /api/*, /webhook/* and for /mcp from Claude Code or bots.
API_TOKEN=

# Oura personal access token (https://cloud.ouraring.com/personal-access-tokens). Leave empty to disable.
OURA_TOKEN=
# Hourly at :17 by default (local time, TZ_LOCAL)
OURA_CRON=17 * * * *
OURA_BACKFILL_DAYS=3

TZ_LOCAL=Asia/Jerusalem
